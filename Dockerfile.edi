FROM golang:1.26.10-trixie@sha256:909771fef53e3dcb0950255f0c9a8b4728c3b841e61509c7b29b098de7ee02d4 AS builder
WORKDIR /source
COPY . .
ARG SOURCE_REVISION
RUN edi/build.sh /runtime "$SOURCE_REVISION"

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
RUN apt-get update && apt-get install --no-install-recommends -y ca-certificates media-types \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 1000 sftpgo \
    && useradd --system --uid 1000 --gid 1000 --home-dir /var/lib/sftpgo \
       --no-create-home --shell /usr/sbin/nologin sftpgo \
    && mkdir -p /etc/sftpgo /var/lib/sftpgo /data/sftp /usr/share/sftpgo \
    && chown 1000:1000 /var/lib/sftpgo /data/sftp
COPY --from=builder /runtime/sftpgo /usr/local/bin/sftpgo
COPY --from=builder /runtime/templates /usr/share/sftpgo/templates
COPY --from=builder /runtime/LICENSE /runtime/NOTICE /runtime/build-inputs.env /runtime/build-provenance.json /runtime/go-build-info.txt /usr/share/sftpgo/
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/bettiah/sftpgo" \
      org.opencontainers.image.revision="$SOURCE_REVISION" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
ENV HOME=/var/lib/sftpgo SFTPGO_CONFIG_DIR=/etc/sftpgo SFTPGO_LOG_FILE_PATH="" \
    SFTPGO_SMTP__TEMPLATES_PATH=/usr/share/sftpgo/templates
WORKDIR /var/lib/sftpgo
USER 1000:1000
CMD ["sftpgo", "serve"]
